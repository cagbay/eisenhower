{
  "name": "IFC Viewer",
  "short_name": "IFC Viewer",
  "description": "IFC Modelle auf dem iPad ansehen: 3D, Struktur, Eigenschaften, Messen, Schnitt und Karte in LV95.",
  "lang": "de-CH",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#e6eaee",
  "theme_color": "#0b67a3",
  "icons": [
    {
      "src": "icons/icon-192-v2.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512-v2.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512-v2.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-ifcv": [
          ".ifcv"
        ]
      },
      "icons": [
        {
          "src": "icons/file-ifcv-256.png",
          "sizes": "256x256",
          "type": "image/png"
        },
        {
          "src": "icons/file-ifcv-64.png",
          "sizes": "64x64",
          "type": "image/png"
        }
      ]
    },
    {
      "action": "./",
      "accept": {
        "application/x-step": [
          ".ifc"
        ]
      },
      "icons": [
        {
          "src": "icons/file-ifc-256.png",
          "sizes": "256x256",
          "type": "image/png"
        },
        {
          "src": "icons/file-ifc-64.png",
          "sizes": "64x64",
          "type": "image/png"
        }
      ]
    },
    {
      "action": "./",
      "accept": {
        "application/zip": [
          ".ifczip"
        ]
      },
      "icons": [
        {
          "src": "icons/file-ifczip-256.png",
          "sizes": "256x256",
          "type": "image/png"
        },
        {
          "src": "icons/file-ifczip-64.png",
          "sizes": "64x64",
          "type": "image/png"
        }
      ]
    },
    {
      "action": "./",
      "accept": {
        "image/vnd.dxf": [
          ".dxf"
        ]
      },
      "icons": [
        {
          "src": "icons/file-dxf-256.png",
          "sizes": "256x256",
          "type": "image/png"
        },
        {
          "src": "icons/file-dxf-64.png",
          "sizes": "64x64",
          "type": "image/png"
        }
      ]
    },
    {
      "action": "./",
      "accept": {
        "application/octet-stream": [
          ".laz"
        ]
      },
      "icons": [
        {
          "src": "icons/file-laz-256.png",
          "sizes": "256x256",
          "type": "image/png"
        },
        {
          "src": "icons/file-laz-64.png",
          "sizes": "64x64",
          "type": "image/png"
        }
      ]
    },
    {
      "action": "./",
      "accept": {
        "application/vnd.las": [
          ".las"
        ]
      },
      "icons": [
        {
          "src": "icons/file-las-256.png",
          "sizes": "256x256",
          "type": "image/png"
        },
        {
          "src": "icons/file-las-64.png",
          "sizes": "64x64",
          "type": "image/png"
        }
      ]
    }
  ]
}
